# LAB "native": Ubuntu 22.04 (jammy) + Ubuntu-packaged nginx-extras at the VULNERABLE 14.22 build.
FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
# containers have no systemd: stop apt from trying to start services
RUN printf '#!/bin/sh\nexit 101\n' > /usr/sbin/policy-rc.d && chmod +x /usr/sbin/policy-rc.d
# pin every nginx package to the vulnerable 14.22 build (priority >1000 also allows the downgrade)
RUN printf 'Package: nginx nginx-* libnginx-mod-*\nPin: version 1.18.0-6ubuntu14.22\nPin-Priority: 1001\n' > /etc/apt/preferences.d/00-lab-pin \
 && apt-get update && apt-get install -y sudo curl vim-tiny less procps nginx-extras
# release the pin so the lab user can practise the upgrade
RUN rm /etc/apt/preferences.d/00-lab-pin
COPY site/default.conf /etc/nginx/conf.d/default.conf
WORKDIR /root
CMD ["sleep","infinity"]
